        <mxCell id="arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1976D2;flowAnimation=1;curved=1;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1976D2;flowAnimation=1;curved=1;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1976D2;flowAnimation=1;curved=1;" edge="1" parent="1" source="step3" target="backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Response Arrows -->
        <mxCell id="arr5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#E65100;flowAnimation=1;curved=1;entryX=1;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="backend" target="step4">
          <mxGeometry relative="1" as="geometry" />

        <mxCell id="arr6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#E65100;flowAnimation=1;curved=1;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#E65100;flowAnimation=1;curved=1;" edge="1" parent="1" source="step5" target="step6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arr8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#E65100;flowAnimation=1;curved=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="step6" target="client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="70" y="455" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- API Gateway Box -->
        <mxCell id="apigw-box" value="" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF8C00;strokeWidth=3;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="400" height="440" as="geometry" />
        </mxCell>
        <mxCell id="apigw-label" value="API Gateway" style="text;html=1;strokeColor=none;fillColor=#FFE4B5;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#FF8C00;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="120" height="25" as="geometry" />

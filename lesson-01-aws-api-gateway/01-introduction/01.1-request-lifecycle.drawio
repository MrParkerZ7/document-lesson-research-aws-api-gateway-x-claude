        <!-- Notes -->
        <mxCell id="notes" value="Key Points:&#xa;• Validation happens BEFORE reaching backend&#xa;• VTL templates transform requests/responses&#xa;• Cache can bypass backend entirely&#xa;• Each step can return early on error" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;shadow=1;fontSize=11;spacing=8;" vertex="1" parent="1">

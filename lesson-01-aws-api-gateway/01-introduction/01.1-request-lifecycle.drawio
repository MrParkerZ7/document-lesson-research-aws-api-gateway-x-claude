<mxfile host="app.diagrams.net" modified="2024-01-15T10:00:00.000Z" agent="Claude" version="22.1.0">
  <diagram name="Request Lifecycle" id="request-lifecycle">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="API Gateway Request/Response Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Client -->
        <mxCell id="client" value="Client" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="60" height="80" as="geometry" />
        </mxCell>

        <!-- Request Flow -->
        <mxCell id="request-label" value="REQUEST FLOW" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#1976D2;" vertex="1" parent="1">
          <mxGeometry x="550" y="80" width="150" height="30" as="geometry" />
        </mxCell>

        <!-- Step 1: HTTP Request -->
        <mxCell id="step1" value="1. HTTP Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="200" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Step 2: Method Request -->
        <mxCell id="step2" value="2. Method Request" style="swimlane;horizontal=1;startSize=25;fillColor=#fff3e0;strokeColor=#ff9800;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="120" width="160" height="180" as="geometry" />
        </mxCell>
        <mxCell id="step2a" value="Authorization&#xa;(IAM, Cognito, Lambda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;shadow=1;fontSize=10;" vertex="1" parent="step2">
          <mxGeometry x="10" y="35" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step2b" value="Request Validation&#xa;(params, body, headers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;fontSize=10;" vertex="1" parent="step2">
          <mxGeometry x="10" y="85" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step2c" value="API Key Check&#xa;(if required)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;shadow=1;fontSize=10;" vertex="1" parent="step2">
          <mxGeometry x="10" y="135" width="140" height="35" as="geometry" />
        </mxCell>

        <!-- Step 3: Integration Request -->
        <mxCell id="step3" value="3. Integration Request" style="swimlane;horizontal=1;startSize=25;fillColor=#e8f5e9;strokeColor=#43a047;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="160" height="180" as="geometry" />
        </mxCell>
        <mxCell id="step3a" value="VTL Transformation&#xa;(map request)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;shadow=1;fontSize=10;" vertex="1" parent="step3">
          <mxGeometry x="10" y="35" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step3b" value="Parameter Mapping&#xa;(path, query, headers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;shadow=1;fontSize=10;" vertex="1" parent="step3">
          <mxGeometry x="10" y="85" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step3c" value="AWS Service&#xa;Integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#43a047;shadow=1;fontSize=10;" vertex="1" parent="step3">
          <mxGeometry x="10" y="135" width="140" height="35" as="geometry" />
        </mxCell>

        <!-- Backend -->
        <mxCell id="backend" value="Backend&#xa;(Lambda, HTTP,&#xa;AWS Service)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="175" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Response Flow -->
        <mxCell id="response-label" value="RESPONSE FLOW" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="550" y="340" width="150" height="30" as="geometry" />
        </mxCell>

        <!-- Step 4: Integration Response -->
        <mxCell id="step4" value="4. Integration Response" style="swimlane;horizontal=1;startSize=25;fillColor=#fce4ec;strokeColor=#e91e63;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="380" width="160" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step4a" value="Response Mapping&#xa;(by status code)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#e91e63;shadow=1;fontSize=10;" vertex="1" parent="step4">
          <mxGeometry x="10" y="35" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step4b" value="Error Handling&#xa;(timeout, errors)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#e91e63;shadow=1;fontSize=10;" vertex="1" parent="step4">
          <mxGeometry x="10" y="85" width="140" height="45" as="geometry" />
        </mxCell>

        <!-- Step 5: Method Response -->
        <mxCell id="step5" value="5. Method Response" style="swimlane;horizontal=1;startSize=25;fillColor=#f3e5f5;strokeColor=#9c27b0;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="380" width="160" height="140" as="geometry" />
        </mxCell>
        <mxCell id="step5a" value="VTL Transformation&#xa;(map response)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#9c27b0;shadow=1;fontSize=10;" vertex="1" parent="step5">
          <mxGeometry x="10" y="35" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="step5b" value="Header Mapping&#xa;Status Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1bee7;strokeColor=#9c27b0;shadow=1;fontSize=10;" vertex="1" parent="step5">
          <mxGeometry x="10" y="85" width="140" height="45" as="geometry" />
        </mxCell>

        <!-- Step 6: HTTP Response -->
        <mxCell id="step6" value="6. HTTP Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffecb3;strokeColor=#ff9800;shadow=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="430" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Request Arrows -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#1976D2;flowAnimation=1;curved=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="client" target="step1">
          <mxGeometry relative="1" as="geometry" />

        <!-- Cache indicator -->
        <mxCell id="cache" value="Cache&#xa;(Optional)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="300" width="80" height="60" as="geometry" />

        </mxCell>
        <mxCell id="apigw-list" value="✓ Serverless (Lambda) backends&#xa;✓ AWS-native applications&#xa;✓ REST APIs with transformations&#xa;✓ WebSocket real-time apps&#xa;✓ Quick deployment&#xa;✓ Pay-per-request pricing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=5;" vertex="1" parent="1">

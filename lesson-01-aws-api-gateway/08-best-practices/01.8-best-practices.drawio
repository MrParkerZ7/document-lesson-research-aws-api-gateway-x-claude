        <!-- API Design -->
        <mxCell id="design-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="320" height="240" as="geometry" />

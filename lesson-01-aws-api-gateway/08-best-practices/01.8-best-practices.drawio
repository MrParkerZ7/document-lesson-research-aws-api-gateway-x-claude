        <mxCell id="design-title" value="API Design" style="text;html=1;strokeColor=none;fillColor=#1565C0;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="90" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="design-icon" value="📐" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=40;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="design-list" value="✓ Use plural nouns: /customers&#xa;✓ Use HTTP methods correctly&#xa;✓ Version in URL path: /v1/...&#xa;✓ Consistent error format&#xa;✓ Pagination with cursors&#xa;✓ HATEOAS links in responses&#xa;✓ Use proper status codes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="130" y="130" width="210" height="130" as="geometry" />
        </mxCell>
        <mxCell id="design-tip" value="💡 Design for consumers, not implementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bbdefb;strokeColor=#1565c0;shadow=1;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- Performance -->
        <mxCell id="perf-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;shadow=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="80" width="320" height="240" as="geometry" />

        <mxCell id="perf-title" value="Performance" style="text;html=1;strokeColor=none;fillColor=#2E7D32;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="90" width="180" height="30" as="geometry" />

        <mxCell id="security-title" value="Security" style="text;html=1;strokeColor=none;fillColor=#C2185B;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="810" y="90" width="180" height="30" as="geometry" />

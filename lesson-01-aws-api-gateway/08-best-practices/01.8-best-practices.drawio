        <mxCell id="cost-title" value="Cost Optimization" style="text;html=1;strokeColor=none;fillColor=#E65100;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;fontColor=#ffffff;rounded=1;" vertex="1" parent="1">

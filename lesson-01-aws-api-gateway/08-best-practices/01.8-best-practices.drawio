        <mxCell id="cost-list" value="✓ HTTP API over REST API&#xa;✓ Use AWS Service integrations&#xa;✓ Right-size cache capacity&#xa;✓ Monitor cache hit rate&#xa;✓ Return only needed fields&#xa;✓ Set appropriate throttle limits&#xa;✓ Review CloudWatch costs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="130" y="400" width="210" height="130" as="geometry" />

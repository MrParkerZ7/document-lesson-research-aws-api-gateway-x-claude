        <mxCell id="cost-compare" value="REST: $3.50/M  →  HTTP: $1.00/M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;shadow=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="280" height="30" as="geometry" />
